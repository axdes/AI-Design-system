{
  "ref": "DateRangePicker",
  "level": "molecule",
  "description": "A date-span field: one trigger, one <Calendar>, two picks. The first click marks the start, the second closes with the ordered range (picking backwards swaps the ends instead of failing). One date is <DatePicker>; this is the from/to filter over a list or a report.",
  "exports": [
    "DateRangePicker"
  ],
  "main": "DateRangePicker",
  "from": "@/components/DateRangePicker",
  "slots": [],
  "props": [
    {
      "name": "value",
      "type": "DateRange",
      "required": false
    },
    {
      "name": "onChange",
      "type": "(range: DateRange) => void",
      "required": true
    },
    {
      "name": "min",
      "type": "Date",
      "required": false
    },
    {
      "name": "max",
      "type": "Date",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false
    },
    {
      "name": "locale",
      "type": "string",
      "required": false
    },
    {
      "name": "invalid",
      "type": "boolean",
      "required": false
    },
    {
      "name": "surface",
      "type": "'base' | 'muted'",
      "required": false,
      "values": [
        "base",
        "muted"
      ]
    },
    {
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "required": false,
      "values": [
        "sm",
        "md",
        "lg"
      ]
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false
    },
    {
      "name": "className",
      "type": "string",
      "required": false
    }
  ],
  "sourcePath": "src/components/DateRangePicker/DateRangePicker.tsx",
  "variants": {
    "invalid": {
      "prop": "invalid",
      "values": [
        "true"
      ]
    },
    "surface": {
      "prop": "surface",
      "values": [
        "base",
        "muted"
      ]
    },
    "size": {
      "prop": "size",
      "values": [
        "sm",
        "md",
        "lg"
      ]
    }
  },
  "uses": [
    "Calendar",
    "Icon",
    "Popover"
  ],
  "example": "const [stay, setStay] = useState<DateRange | undefined>()\n/* Two picks in one calendar: the first click marks the start, the second\n * closes with the ordered range. onChange only fires with both ends set. */\n\n<DateRangePicker\n  label=\"Stay dates\"\n  value={stay}\n  onChange={setStay}\n  placeholder=\"Select dates\"\n/>"
}
