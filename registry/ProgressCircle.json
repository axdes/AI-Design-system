{
  "ref": "ProgressCircle",
  "level": "atom",
  "description": "Progress as a ring: the compact dashboard counterpart to <ProgressBar> (linear, ongoing work) and <Meter> (linear, fixed scale). The circle is drawn with pathLength=100 so the dash pattern speaks in percent; --pct is the only dynamic style.",
  "exports": [
    "ProgressCircle"
  ],
  "main": "ProgressCircle",
  "from": "@/components/ProgressCircle",
  "slots": [],
  "props": [
    {
      "name": "value",
      "type": "number",
      "required": true
    },
    {
      "name": "max",
      "type": "number",
      "required": false
    },
    {
      "name": "tone",
      "type": "Tone",
      "required": false,
      "values": [
        "primary",
        "success",
        "warning",
        "danger"
      ]
    },
    {
      "name": "size",
      "type": "Size",
      "required": false,
      "values": [
        "sm",
        "md",
        "lg"
      ]
    },
    {
      "name": "showValue",
      "type": "boolean",
      "required": false
    },
    {
      "name": "formatValue",
      "type": "(value: number, max: number) => string",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "className",
      "type": "string",
      "required": false
    }
  ],
  "sourcePath": "src/components/ProgressCircle/ProgressCircle.tsx",
  "variants": {
    "tone": {
      "prop": "tone",
      "values": [
        "primary",
        "success",
        "warning",
        "danger"
      ]
    },
    "size": {
      "prop": "size",
      "values": [
        "sm",
        "md",
        "lg"
      ]
    }
  },
  "example": "/* A KPI ring on a dashboard card. `label` is what a screen reader announces;\n * `showValue` prints the rounded percentage in the middle. */\n\n<ProgressCircle value={68} label=\"Storage used\" showValue />"
}
