{
  "ref": "DateBlock",
  "level": "atom",
  "description": "A date as a block the eye lands on first: the month small over the day large. For an EVENT, where the reader scans by date — a timestamp inside a sentence is <Time>, and a field in a record is a plain value.",
  "exports": [
    "DateBlock"
  ],
  "main": "DateBlock",
  "from": "@/components/DateBlock",
  "slots": [],
  "props": [
    {
      "name": "value",
      "type": "string | number | Date",
      "required": true,
      "description": "ISO string, epoch milliseconds, or a Date."
    },
    {
      "name": "locale",
      "type": "string",
      "required": false,
      "description": "BCP-47 tag. Omit to follow the browser."
    },
    {
      "name": "tone",
      "type": "Tone",
      "required": false,
      "description": "Fills the block as a coloured tile. Omitted, the date is type in ink, which is what a card wants; a tone is for a calendar strip.",
      "values": [
        "neutral",
        "primary",
        "success",
        "warning",
        "danger"
      ]
    },
    {
      "name": "size",
      "type": "Size",
      "required": false,
      "values": [
        "sm",
        "md"
      ]
    },
    {
      "name": "className",
      "type": "string",
      "required": false
    }
  ],
  "sourcePath": "src/components/DateBlock/DateBlock.tsx",
  "variants": {
    "tone": {
      "prop": "tone",
      "values": [
        "neutral",
        "primary",
        "success",
        "warning",
        "danger"
      ]
    },
    "size": {
      "prop": "size",
      "values": [
        "sm",
        "md"
      ]
    }
  },
  "uses": [
    "Card",
    "Layout",
    "SectionLabel"
  ],
  "example": "<Stack gap={6}>\n  <Stack gap={2}>\n    <SectionLabel as=\"h3\">Upcoming sessions</SectionLabel>\n    <Card>\n      <Row gap={4} align=\"center\">\n        <DateBlock value=\"2026-09-30T09:00:00Z\" tone=\"primary\" />\n        <span>Design sprint, day one</span>\n      </Row>\n    </Card>\n    <Card>\n      <Row gap={4} align=\"center\">\n        <DateBlock value=\"2026-10-02T09:00:00Z\" />\n        <span>Delivery review</span>\n      </Row>\n    </Card>\n  </Stack>\n  \n  <Card>\n    <Row gap={3} align=\"center\">\n      <DateBlock value=\"2026-08-14T09:00:00Z\" tone=\"danger\" size=\"sm\" />\n      <span>Safety audit, not yet signed off</span>\n    </Row>\n  </Card>\n</Stack>"
}
