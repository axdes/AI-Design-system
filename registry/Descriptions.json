{
  "ref": "Descriptions",
  "level": "molecule",
  "description": "A read-only list of field/value pairs — a record's metadata, a summary panel. Real <dl>/<dt>/<dd> so it reads as a description list to a screen reader. Distinct from a form (no inputs) and from a Table (no rows of records).",
  "exports": [
    "Descriptions"
  ],
  "main": "Descriptions",
  "from": "@/components/Descriptions",
  "slots": [],
  "props": [
    {
      "name": "items",
      "type": "Description[]",
      "required": true
    },
    {
      "name": "layout",
      "type": "'stacked' | 'inline'",
      "required": false,
      "description": "stacked (term above value, default) or inline (term beside value).",
      "values": [
        "stacked",
        "inline"
      ]
    },
    {
      "name": "columns",
      "type": "1 | 2 | 3",
      "required": false,
      "description": "Columns on wide screens (stacked layout only). Default 1.",
      "values": [
        1,
        2,
        3
      ]
    },
    {
      "name": "className",
      "type": "string",
      "required": false
    }
  ],
  "sourcePath": "src/components/Descriptions/Descriptions.tsx",
  "variants": {
    "layout": {
      "prop": "layout",
      "values": [
        "stacked",
        "inline"
      ]
    },
    "columns": {
      "prop": "columns",
      "values": [
        1,
        2,
        3
      ]
    }
  },
  "uses": [
    "Badge",
    "Layout"
  ],
  "example": "<Stack gap={6}>\n  <Descriptions columns={2} items={RECORD} />\n  <Descriptions layout=\"inline\" items={RECORD.slice(0, 3)} />\n</Stack>"
}
